{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user profile and aggregate meditation stats.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "totalMinutes": { "type": "integer" },
        "totalSessions": { "type": "integer" },
        "currentStreak": { "type": "integer" },
        "nasheedMinutes": { "type": "integer" },
        "dhikrMinutes": { "type": "integer" },
        "retreatMinutes": { "type": "integer" },
        "journalMinutes": { "type": "integer" },
        "growthMinutes": { "type": "integer" },
        "lastSessionAt": { "type": "string", "format": "date-time" },
        "lastActiveDate": { "type": "string", "format": "date-time" },
        "settings": { "type": "object" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Reflection": {
      "title": "Journal Reflection",
      "description": "User journal entries for gratitude and contemplation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "mood": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "text", "createdAt"]
    },
    "Session": {
      "title": "Meditation Session",
      "description": "Records individual sessions of silence, dhikr, or retreat.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["silence", "dhikr", "retreat"] },
        "duration": { "type": "integer" },
        "dhikrText": { "type": "string" },
        "dhikrCount": { "type": "integer" },
        "moodBefore": { "type": "string" },
        "moodAfter": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "createdAt"]
    },
    "SpiritualAssessment": {
      "title": "Spiritual Mirror Assessment",
      "description": "Results of the spiritual self-assessment mirror.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "scores": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "overallTitle": { "type": "string" }
      },
      "required": ["userId", "scores", "createdAt"]
    },
    "HabitTask": {
      "title": "Habit Progress",
      "description": "Daily habit completion records.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "habitId": { "type": "string" },
        "habitTitle": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" },
        "date": { "type": "string" }
      },
      "required": ["userId", "habitId", "date"]
    },
    "EthicsCommitment": {
      "title": "Ethical Commitment",
      "description": "User commitments to change specific ethical behaviors.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "ethicId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "struggling"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "ethicId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user profiles and stats."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "Session",
      "description": "User specific meditation history."
    },
    "/users/{userId}/reflections/{reflectionId}": {
      "schema": "Reflection",
      "description": "User specific journal reflections."
    },
    "/users/{userId}/assessments/{assessmentId}": {
      "schema": "SpiritualAssessment",
      "description": "History of spiritual mirror checks."
    },
    "/users/{userId}/habits/{habitProgressId}": {
      "schema": "HabitTask",
      "description": "History of habit completions."
    },
    "/users/{userId}/ethics_commitments/{commId}": {
      "schema": "EthicsCommitment",
      "description": "Active ethical commitments for reform."
    }
  }
}
