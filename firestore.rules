rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // --- User Profile Rules ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && 
                    request.resource.data.uid == resource.data.uid &&
                    (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'totalMinutes', 'totalSessions', 'currentStreak', 'nasheedMinutes', 'dhikrMinutes', 'retreatMinutes', 'journalMinutes', 'growthMinutes', 'lastSessionAt', 'lastActiveDate', 'settings']) ||
                      request.resource.data.diff(resource.data).affectedKeys().hasAll(['displayName', 'photoURL', 'totalMinutes', 'totalSessions', 'currentStreak', 'settings']) // for setDoc updates
                    );

      // --- Sessions Subcollection ---
      function isValidSession(data) {
        return data.userId == request.auth.uid &&
               data.type in ['silence', 'dhikr', 'retreat'] &&
               data.createdAt == request.time &&
               data.duration is int;
      }

      match /sessions/{sessionId} {
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSession(request.resource.data);
        allow update, delete: if false; // Sessions are immutable logs
      }

      // --- Reflections Subcollection ---
      function isValidReflection(data) {
        return data.userId == request.auth.uid &&
               data.text is string && 
               data.text.size() <= 10000 &&
               data.createdAt == request.time;
      }

      match /reflections/{reflectionId} {
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidReflection(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
